  "cards": [
    { "dot": "rose", "title": "The one rule: host decides, clients ask", "items": [
      "Every gameplay change is a ServerRpc intent; the host checks the sender owns the avatar and is in range",
      "State reaches clients through NetworkVariables / NetworkLists, spawns and SendTo.NotServer mirror RPCs",
      "UIManager sends alerts and option menus only to the acting client (RpcTarget.Single)"
    ] },
    { "dot": "emerald", "title": "Core gameplay loop", "items": [
      "BotManager spawns pooled customers; each orders a random dish from the menu",
      "Players carry ingredients to counters and tools; CookingTool runs cook → cooked → burned timers",
      "Picking up an eaten plate collects cash + EXP into GameManager"
    ] },
    { "dot": "cyan", "title": "Hosting and joining", "items": [
      "Host: NewGame/LoadGame → Relay allocation → NetworkManager loads GameScene",
      "Client: join code → Relay → host sends GameData gzipped in 4 KB chunks",
      "Single-player uses a local transport via StartSinglePlayer"
    ] },
    { "dot": "amber", "title": "Data and persistence", "items": [
      "Content lives in ScriptableObjects referenced by asset GUID in saves and RPCs",
      "Only the host saves: dirty flag, max once per second, immediate on pause/quit",
      "Rewarded ads are client-reported; interstitials fire every 5 min from InGameState"
    ] }
  ]
